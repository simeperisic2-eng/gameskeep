# ───────────────────────────────────────────────────────────────────
# GamesKeep — environment configuration (EXAMPLE)
#
# Copy to `.env` only if you need to override defaults. The demo boots
# with ZERO real secrets: every value below is a safe demo default or
# blank. Production-only secrets are listed (so prod knows exactly where
# each key goes) but MUST stay blank in demo.
# Cross-reference: ASSETS.md §3 (which key powers which feature).
# Secrets are NEVER committed — `.env` is git-ignored.
# ───────────────────────────────────────────────────────────────────

# ---- App mode: the demo <-> production seam ------------------------
# demo       = mock data sources, no live external calls (default).
# production = live RSS/IGDB/Steam adapters plug in here later.
APP_MODE=demo
NODE_ENV=development
LOG_LEVEL=info

# ---- Main app: backend API ----------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
# Comma-separated origins allowed to call the API (the frontend).
CORS_ORIGINS=http://localhost:3000
# Token guarding the admin API (/admin/api/*). The frontend admin console proxy
# injects it server-side. Demo default lets the stack boot with no secrets;
# CHANGE for production (a production boot REFUSES to start with this default).
# Full permissioned Control Panel + login arrive in I8.
ADMIN_API_TOKEN=demo-admin-token
# Reverse-proxy trust (I6 security). 'false' (default) = the client IP is the
# unspoofable socket peer and X-Forwarded-For is IGNORED — required so per-IP
# login throttles can't be defeated by a forged header. Behind Cloudflare/Nginx
# in production set a hop count ('1') or a CIDR list — never blanket 'true'.
TRUST_PROXY=false

# ---- Main app: frontend (Next.js) ---------------------------------
FRONTEND_PORT=3000
# URL the frontend uses to reach the backend during server-side render.
# In docker-compose this is the service name; on the host it is localhost.
BACKEND_INTERNAL_URL=http://backend:4000
# Public URL of the site (used for canonical / Open Graph tags later).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- AI microservice ----------------------------------------------
AI_HOST=0.0.0.0
AI_PORT=8000
# URL the backend uses to reach the AI service.
AI_SERVICE_URL=http://ai:8000

# ---- PostgreSQL (with the pgvector extension) ---------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gameskeep
POSTGRES_USER=gameskeep
# Demo-only password. CHANGE for production; never commit a real one.
POSTGRES_PASSWORD=gameskeep_demo
# Connection URL used by pg / drizzle (demo credentials only).
DATABASE_URL=postgresql://gameskeep:gameskeep_demo@postgres:5432/gameskeep

# ---- Redis (cache + background-job queue) -------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ───────────────────────────────────────────────────────────────────
# PRODUCTION-ONLY SECRETS — leave BLANK in demo (see ASSETS.md §3).
# Documented here so production knows exactly where each key goes.
# ───────────────────────────────────────────────────────────────────
# Game metadata, primary — IGDB via Twitch OAuth
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Game metadata, fallback — RAWG
RAWG_API_KEY=
# Player counts / prices / review % — Steam Web API
STEAM_API_KEY=
# Game-page videos — YouTube Data API v3
YOUTUBE_API_KEY=
# Transactional email — verification / notifications / newsletter
EMAIL_PROVIDER_API_KEY=
# Optional social login (OAuth apps)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_STEAM_API_KEY=
# Session signing secret — generate for production; demo uses a default.
SESSION_SECRET=
